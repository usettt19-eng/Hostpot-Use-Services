NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-publicable
# Solo servidor. Nunca exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# Solo servidor. Cifra la contraseña del router: openssl rand -base64 32
ROUTER_CRED_KEY=genera-con-openssl-rand-base64-32
# Solo servidor. Autoriza el proceso periódico de invitados: openssl rand -hex 32
CRON_SECRET=genera-con-openssl-rand-hex-32
# Solo servidor. Correos (separados por coma) con acceso al panel /platform (todos los establecimientos)
PLATFORM_ADMIN_EMAILS=
# Solo servidor. 1 = cualquiera puede crear un establecimiento en /register-school. Por defecto cerrado: los crea el dueño en /platform
ALLOW_PUBLIC_SCHOOL_REGISTRATION=
# Solo servidor. Dirección pública del portal (sin barra final); la usan los enlaces de recuperar contraseña. Si queda vacía se toma de la petición.
SITE_URL=
# Solo servidor. Correo de salida (códigos de verificación del WiFi). Cualquier proveedor SMTP:
#   SMTP_URL=smtps://usuario:clave@servidor:465   (si la clave tiene símbolos, codifícala para URL)
#   MAIL_FROM="Nombre del servicio <no-responder@tu-dominio.com>"
# Sin estas dos variables, un local con «Verificar el correo» activado no deja conectar a los visitantes.
SMTP_URL=
MAIL_FROM=
